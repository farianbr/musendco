# Copy to .env.local for development. Never commit real secrets.

# Public origin used for canonical URLs, Open Graph and the sitemap.
# Must be an absolute http(s) URL. Defaults to https://musendco.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery via Resend (https://resend.com). All three are required
# to send; without them the form validates and offers a prefilled email instead.
RESEND_API_KEY=
# Inbox that receives inquiries.
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Musendco <website@musendco.com>".
CONTACT_FROM_EMAIL=
