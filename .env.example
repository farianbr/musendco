# Copy to .env.local for development. Never commit real secrets.

# Public origin used for canonical URLs, Open Graph and the sitemap.
# Must be an absolute http(s) URL. Defaults to https://musendco.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery via SMTP. Everything except SMTP_PORT is required to
# send; without it the form validates and offers a prefilled email instead.
SMTP_HOST=mail.privateemail.com
# Optional. Defaults to 465.
SMTP_PORT=465
# Full mailbox address and its password.
SMTP_USER=
SMTP_PASS=
# Inbox that receives inquiries.
CONTACT_TO_EMAIL=
# Must be the SMTP mailbox or one of its aliases, e.g. "Musendco <hello@musendco.com>".
CONTACT_FROM_EMAIL=
